# Optional grounded Gemini policy-copilot integration. The backend still works
# without a key and falls back to the deterministic evidence service.
GEMINI_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional SQLite location. Defaults to data/dashboard.db.
DOSM_DB_PATH=
